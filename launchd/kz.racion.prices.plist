<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>kz.racion.prices</string>
  <key>ProgramArguments</key>
  <array><string>/Users/USERNAME/racion/update.sh</string></array>
  <key>StartCalendarInterval</key>
  <dict><key>Hour</key><integer>8</integer><key>Minute</key><integer>10</integer></dict>
  <key>StandardOutPath</key><string>/tmp/racion.out</string>
  <key>StandardErrorPath</key><string>/tmp/racion.err</string>
</dict>
</plist>
